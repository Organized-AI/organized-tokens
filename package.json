{
  "name": "organized-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only AI token audit — landing page and script, served from Cloudflare Worker Assets.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "python3 -m py_compile public/tokens.py && echo 'tokens.py compiles'",
    "gtm:test": "node --experimental-strip-types --test gtm/test/*.test.mjs",
    "gtm:prepare": "node --experimental-strip-types gtm/prepare.mjs",
    "gtm:collect-niceboard": "node --experimental-strip-types gtm/collect-niceboard.mjs",
    "gtm:collect-jobs": "node --experimental-strip-types gtm/collect-jobs.mjs",
    "gtm:collect-partner-routes": "node --experimental-strip-types gtm/collect-partner-routes.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
