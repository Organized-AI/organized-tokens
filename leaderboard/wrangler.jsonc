{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organized-tokens-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // run_worker_first so the Worker can route "/" by hostname; static files
  // still come from ASSETS via the fall-through at the end of fetch().
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "organized-tokens-leaderboard",
      "database_id": "6e4bc0fd-c3c9-4976-ae83-f8b99585f3ce"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "routes": [
    { "pattern": "board.organizedai.vip", "custom_domain": true },
    { "pattern": "assessment.organizedai.vip", "custom_domain": true }
  ],

  "observability": { "enabled": true }

  // ADMIN_SECRET is a secret, not a var:
  //   npx wrangler secret put ADMIN_SECRET
}
